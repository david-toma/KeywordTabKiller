{
  "manifest_version": 3,
  "name": "Keyword Tab Killer",
  "description": "Closes the tab as soon as its URL or search query contains a blocked word.",
  "version": "1.0.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "permissions": ["tabs", "webNavigation", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"]
}
